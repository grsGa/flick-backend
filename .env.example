# ===========================================
# Flick Backend Environment Configuration
# ===========================================

# Gateway Service Configuration
GATEWAY_PORT=8080

# Microservices Ports Configuration
AUTH_SERVICE_PORT=50053
USER_SERVICE_PORT=50051
CONTENT_SERVICE_PORT=50052
MEDIA_SERVICE_PORT=50054
MESSAGES_SERVICE_PORT=50055
NOTIFICATION_SERVICE_PORT=50056
INTERACTION_SERVICE_PORT=50057
RECOMMENDATION_SERVICE_PORT=50058
SEARCH_SERVICE_PORT=50059

# Service Discovery Configuration
CONSUL_AGENT_ADDR=consul:8500

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=flick

# OAuth Configuration - GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# OAuth Configuration - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=social-media
MINIO_PUBLIC_URL=http://localhost:9000

# Media Processing Configuration
TEMP_DIR=/tmp/media-processing

# SSL/TLS Configuration
CUSTOM_CA_CERT_PATH=/etc/ssl/certs/custom/ca.crt
