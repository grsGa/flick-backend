# Authentication related GraphQL types

type AuthPayload {
  token: String!
  user: User!
}

input LoginInput {
  username: String!
  password: String!
}

input RegisterInput {
  username: String!
  email: String!
  password: String!
  displayName: String
  phone: String
}

# Common GraphQL types

scalar Upload

# Content related GraphQL types

type Post {
  id: ID!
  content: String!
  author: User!
  visibility: PostVisibility!
  replyPermission: ReplyPermission!
  parentId: ID
  rootId: ID
  repostId: ID
  isReply: Boolean!
  replyLevel: Int!
  hasMedia: Boolean!
  hasPoll: Boolean!
  media: [Media!]!
  mediaAttachments: [MediaAttachment!]!
  mentionedUsers: [ID!]!
  tags: [String!]!
  poll: Poll
  stats: PostStats!
  interaction: Interaction!
  replies(first: Int!, after: String): PostConnection
  parentPost: Post
  replyMention: User
  createdAt: String!
  updatedAt: String!
}

type MediaAttachment {
  id: ID!
  url: String!
  type: String!
}

type Poll {
  id: ID!
  question: String!
  options: [PollOption!]!
  durationMinutes: Int!
  expiresAt: String!
  isExpired: Boolean!
}

type PollOption {
  id: ID!
  text: String!
  voteCount: Int!
}

type PostStats {
  likeCount: Int!
  replyCount: Int!
  repostCount: Int!
  viewCount: Int!
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  FOLLOWERS
}

enum ReplyPermission {
  EVERYONE
  FOLLOWING
  MENTIONED_ONLY
}

input CreatePostInput {
  content: String!
  visibility: PostVisibility
  replyPermission: ReplyPermission
  parentId: ID
  repostId: ID
  mediaUrls: [String!]
  mentionedUsers: [ID!]
  tags: [String!]
  pollData: PollDataInput
}

input PollDataInput {
  question: String!
  options: [String!]!
  durationMinutes: Int!
}


input CreateReplyInput {
  content: String!
  postId: ID!
  parentReplyId: ID
  mediaUrls: [String!]
  mentionedUsers: [ID!]
}

type Media {
  id: ID!
  url: String!
  type: MediaType!
  mimeType: String
  width: Int
  height: Int
  variants: MediaVariants
}

type MediaVariants {
  thumbnail: MediaVariant
  small: MediaVariant
  medium: MediaVariant
  large: MediaVariant
  original: MediaVariant
  preview: MediaVariant
  lowRes: MediaVariant
  midRes: MediaVariant
  highRes: MediaVariant
}

type MediaVariant {
  url: String!
  width: Int!
  height: Int!
  size: Int!
}

enum MediaType {
  IMAGE
  VIDEO
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

type PostEdge {
  node: Post!
  cursor: String!
}

type PostConnection {
  edges: [PostEdge!]!
  pageInfo: PageInfo!
}

# Reply types removed - using Post type for replies instead

# Interaction related GraphQL types

type Interaction {
  isLiked: Boolean!
  isBookmarked: Boolean!
  isReposted: Boolean!
  likeCount: Int!
  replyCount: Int!
  repostCount: Int!
  viewCount: Int!
}

input LikePostInput {
  postId: ID!
}

input BookmarkPostInput {
  postId: ID!
}


input RepostInput {
  postId: ID!
}

# Message related GraphQL types

type Conversation {
  id: ID!
  participants: [User!]!
  lastMessage: Message
  unreadCount: Int!
  createdAt: String!
}

type Message {
  id: ID!
  conversationId: ID!
  sender: User!
  content: String!
  media: Media
  read: Boolean!
  createdAt: String!
}

input CreateMessageInput {
  conversationId: ID!
  content: String!
  mediaId: ID
}

input CreateConversationInput {
  participantIds: [ID!]!
}

type MessageEdge {
  node: Message!
  cursor: String!
}

type MessageConnection {
  edges: [MessageEdge!]!
  pageInfo: PageInfo!
}

# Notification related GraphQL types

type Notification {
  id: ID!
  type: NotificationType!
  actor: User!
  entity: NotificationEntity!
  read: Boolean!
  createdAt: String!
}

enum NotificationType {
  LIKE
  REPLY
  FOLLOW
  REPOST
  BOOKMARK
}

union NotificationEntity = Post | User

type NotificationEdge {
  node: Notification!
  cursor: String!
}

type NotificationConnection {
  edges: [NotificationEdge!]!
  pageInfo: PageInfo!
}

# Recommendation related GraphQL types

type Recommendation {
  id: ID!
  type: RecommendationType!
  entity: RecommendationEntity!
  score: Float!
}

enum RecommendationType {
  USER
  POST
  HASHTAG
}

union RecommendationEntity = User | Post | Hashtag

# Search related GraphQL types

type SearchResults {
  posts: PostConnection
  users: UserConnection
  hashtags: HashtagConnection
}

type Hashtag {
  id: ID!
  name: String!
  postCount: Int!
}

type UserConnection {
  edges: [UserEdge!]!
  pageInfo: PageInfo!
}

type UserEdge {
  node: User!
  cursor: String!
}

type HashtagConnection {
  edges: [HashtagEdge!]!
  pageInfo: PageInfo!
}

type HashtagEdge {
  node: Hashtag!
  cursor: String!
}

input SearchInput {
  query: String!
  types: [SearchType!]
  first: Int
  after: String
}

enum SearchType {
  POST
  USER
  HASHTAG
}

# User related GraphQL types

type User {
  id: ID!
  username: String!
  displayName: String
  bio: String
  location: String
  website: String
  avatarUrl: String
  bannerUrl: String
  followersCount: Int!
  followingCount: Int!
  isFollowing: Boolean
  isVerified: Boolean
  createdAt: String!
}

input UpdateProfileInput {
  displayName: String
  bio: String
  location: String
  website: String
  avatarUrl: String
  bannerUrl: String
}


type Query {
  health: String
  # User queries
  userByUsername(username: String!): User
  # Post queries
  post(id: ID!): Post
  userPosts(username: String!, first: Int!, after: String): PostConnection
  timeline(first: Int!, after: String): PostConnection
  checkReplyPermission(postId: ID!): Boolean!
  userReplies(userId: ID!, first: Int!, after: String): PostConnection
  userMedia(userId: ID!, first: Int!, after: String): PostConnection
  userLikes(userId: ID!, first: Int!, after: String): PostConnection
  homeFeed(first: Int!, after: String): PostConnection
  postReplies(postId: ID!, first: Int!, after: String): PostConnection
  conversationThread(rootId: ID!, first: Int!, after: String): PostConnection
  notifications(first: Int!, after: String): NotificationConnection
  conversations: [Conversation!]!
  conversation(id: ID!): Conversation
  messages(conversationId: ID!, first: Int!, after: String): MessageConnection
  search(input: SearchInput!): SearchResults
  trendingHashtags(first: Int!): [Hashtag!]!
  recommendedUsers(first: Int!): [User!]!
  recommendedPosts(first: Int!): PostConnection
  followers(userId: ID!, first: Int!, after: String): UserConnection
  following(userId: ID!, first: Int!, after: String): UserConnection
}

type Mutation {
  login(input: LoginInput!): AuthPayload!
  register(input: RegisterInput!): AuthPayload!
  uploadMedia(file: Upload!): Media!
  # Post mutations
  createPost(input: CreatePostInput!): Post!
  deletePost(postId: ID!): Boolean!
  createReply(input: CreateReplyInput!): Post!
  deleteReply(replyId: ID!): Boolean!
  likePost(input: LikePostInput!): Interaction!
  unlikePost(input: LikePostInput!): Interaction!
  bookmarkPost(input: BookmarkPostInput!): Interaction!
  unbookmarkPost(input: BookmarkPostInput!): Interaction!
  repost(input: RepostInput!): Interaction!
  undoRepost(input: RepostInput!): Interaction!
  createConversation(input: CreateConversationInput!): Conversation!
  sendMessage(input: CreateMessageInput!): Message!
  markMessageAsRead(messageId: ID!): Message!
  markNotificationAsRead(id: ID!): Notification!
  markAllNotificationsAsRead: Boolean!
  updateProfile(input: UpdateProfileInput!): User!
  followUser(userID: String!): User!
  unfollowUser(userID: String!): User!
}
